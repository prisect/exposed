{
	"schemaVersion": 1,
	"id": "exposed",
	"version": "${version}",
	"name": "Exposed",
	"description": "Shows what's lagging your server, and where. Measures integrated-server tick time and TPS, ranks the block entities and entities that cost the most.",
	"authors": [
		"dotdima"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/exposed"
	},
	"license": "MIT",
	"icon": "assets/exposed/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.exposed.ExposedCommon"
		],
		"client": [
			"dev.exposed.ExposedClient"
		],
		"modmenu": [
			"dev.exposed.ExposedModMenu"
		]
	},
	"mixins": [
		"exposed.mixins.json",
		{
			"config": "exposed.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": ">=21.0.0"
	}
}
